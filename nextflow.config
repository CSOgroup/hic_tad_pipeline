manifest {
    name            = 'hic_tad_pipeline'
    description     = 'Consensus TAD calling from raw Hi-C (.cool/.mcool/.hic) with multiple callers'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
    version         = '1.0.0'
}

params {
    input               = null
    resolution          = null
    outdir              = 'results'
    norm_type           = 'ICE'
    callers             = 'arrowhead,topdom,di,mstd,ontad,spectraltad'
    species             = ''
    chroms              = ''
    consensus_threshold = 0
    consensus_step      = -0.05
    nproc               = 4
}

outputDir = params.outdir
workflow.output.mode = 'copy'

docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: 'CHOOSE_RESOLUTION|BALANCE|CONSENSUS_TADS' {
        cpus = params.nproc
    }
    withLabel: 'ignore_errors' {
        errorStrategy = 'ignore'
    }
}
